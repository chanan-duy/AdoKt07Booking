@page "/"

<PageTitle>Home</PageTitle>

<h1 class="h3 mb-3">Resource Booking System</h1>

<p class="text-muted">Choose a booking flow and check live availability.</p>

<div class="row g-3 mt-1">
	<div class="col-md-6">
		<div class="card shadow-sm border-0 h-100">
			<div class="card-body">
				<h2 class="h5">Hotel Rooms</h2>
				<p class="text-muted mb-3">Search by stay dates and create room bookings.</p>
				<a class="btn btn-primary" href="book-hotel">Book Hotel</a>
			</div>
		</div>
	</div>
	<div class="col-md-6">
		<div class="card shadow-sm border-0 h-100">
			<div class="card-body">
				<h2 class="h5">Restaurant Tables</h2>
				<p class="text-muted mb-3">Search by date-time and reserve a table.</p>
				<a class="btn btn-primary" href="book-table">Book Table</a>
			</div>
		</div>
	</div>
</div>
