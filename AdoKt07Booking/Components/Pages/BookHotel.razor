@page "/book-hotel"
@rendermode InteractiveServer
@inject IHotelService HotelService
@inject IJSRuntime Js

<PageTitle>Book Hotel</PageTitle>

<h1 class="h3 mb-1">Hotel Booking</h1>
<p class="text-muted mb-3">Select a stay window, create a booking, or cancel existing reservations.</p>

<EditForm Model="_filter" OnValidSubmit="RefreshAsync" class="card shadow-sm border-0 mb-3">
	<DataAnnotationsValidator/>
	<div class="card-body">
		<div class="row g-3 align-items-end">
			<div class="col-md-4">
				<label class="form-label">Check-in</label>
				<InputDate @bind-Value="_filter.StartDate" class="form-control"/>
			</div>
			<div class="col-md-4">
				<label class="form-label">Check-out</label>
				<InputDate @bind-Value="_filter.EndDate" class="form-control"/>
			</div>
			<div class="col-md-3">
				<button class="btn btn-primary w-100" type="submit" disabled="@_loading">
					@(_loading ? "Loading..." : "Refresh")
				</button>
			</div>
			<div class="col-md-1 d-grid">
				<button class="btn btn-outline-secondary" type="button" disabled="@_loading" @onclick="SetDefaultDates">Reset</button>
			</div>
		</div>
	</div>
</EditForm>

@if (!string.IsNullOrWhiteSpace(_message))
{
	<div class="alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
}

<div class="row g-3 mb-3">
	<div class="col-sm-6 col-lg-3">
		<div class="card border-0 shadow-sm">
			<div class="card-body py-2">
				<div class="small text-muted">Available</div>
				<div class="h4 mb-0">@AvailableCount</div>
			</div>
		</div>
	</div>
	<div class="col-sm-6 col-lg-3">
		<div class="card border-0 shadow-sm">
			<div class="card-body py-2">
				<div class="small text-muted">Already Booked</div>
				<div class="h4 mb-0">@BookedCount</div>
			</div>
		</div>
	</div>
	<div class="col-lg-6">
		<div class="card border-0 shadow-sm">
			<div class="card-body py-2">
				<div class="small text-muted">Current Window</div>
				<div class="mb-0">@_filter.StartDate.ToString("yyyy-MM-dd") - @_filter.EndDate.ToString("yyyy-MM-dd")</div>
			</div>
		</div>
	</div>
</div>

<div class="card shadow-sm border-0 mb-4">
	<div class="card-header bg-white d-flex justify-content-between align-items-center">
		<strong>Availability</strong>
		<span class="badge text-bg-light">@_availability.Count room(s)</span>
	</div>
	<div class="card-body p-0">
		@if (_availability.Count == 0)
		{
			<div class="p-3 text-muted">No rooms found. Add hotel rooms to the database first.</div>
		}
		else
		{
			<table class="table table-striped mb-0">
				<thead>
				<tr>
					<th>Name</th>
					<th>Type</th>
					<th>Max Occupancy</th>
					<th>Status</th>
					<th class="text-end">Action</th>
				</tr>
				</thead>
				<tbody>
				@foreach (var room in _availability)
				{
					<tr>
						<td>@room.RoomName</td>
						<td>@room.RoomType</td>
						<td>@room.MaxOccupancy</td>
						<td>
							<span class="badge @(room.IsBooked ? "text-bg-secondary" : "text-bg-success")">
								@(room.IsBooked ? "Booked" : "Available")
							</span>
						</td>
						<td class="text-end">
							<button class="btn btn-sm @(room.IsBooked ? "btn-outline-secondary" : "btn-success")"
							        disabled="@(room.IsBooked || _loading)"
							        @onclick="() => BookAsync(room.RoomId)">
								@(room.IsBooked ? "Booked" : "Book")
							</button>
						</td>
					</tr>
				}
				</tbody>
			</table>
		}
	</div>
</div>

<div class="card shadow-sm border-0">
	<div class="card-header bg-white d-flex justify-content-between align-items-center">
		<strong>Bookings</strong>
		<span class="badge text-bg-light">@_bookings.Count</span>
	</div>
	<div class="card-body p-0">
		@if (_bookings.Count == 0)
		{
			<div class="p-3 text-muted">No hotel bookings yet.</div>
		}
		else
		{
			<table class="table table-sm mb-0 align-middle">
				<thead>
				<tr>
					<th>ID</th>
					<th>Room</th>
					<th>Stay</th>
					<th>Status</th>
					<th class="text-end">Action</th>
				</tr>
				</thead>
				<tbody>
				@foreach (var booking in _bookings)
				{
					<tr>
						<td>#@booking.BookingId</td>
						<td>@booking.RoomName</td>
						<td>@booking.StartTime.LocalDateTime.ToString("yyyy-MM-dd") - @booking.EndTime.LocalDateTime.ToString("yyyy-MM-dd")</td>
						<td>
							<span
								class="badge @(booking.Status == BookingStatus.Confirmed ? "text-bg-success" : "text-bg-secondary")">@booking.Status</span>
						</td>
						<td class="text-end">
							@if (booking.Status == BookingStatus.Confirmed)
							{
								<button class="btn btn-sm btn-outline-danger" disabled="@_loading"
								        @onclick="args => CancelAsync(booking.BookingId, args)">Cancel
								</button>
							}
						</td>
					</tr>
				}
				</tbody>
			</table>
		}
	</div>
</div>

@code {
	private readonly HotelFilterModel _filter = new();
	private readonly List<HotelAvailabilityDto> _availability = [];
	private readonly List<HotelBookingListItemDto> _bookings = [];
	private bool _loading;
	private bool _isError;
	private string? _message;
	private int AvailableCount => _availability.Count(x => !x.IsBooked);
	private int BookedCount => _availability.Count - AvailableCount;

	protected override async Task OnInitializedAsync()
	{
		await RefreshAsync();
	}

	private async Task RefreshAsync()
	{
		_loading = true;
		_message = null;
		_isError = false;

		try
		{
			var start = ToLocalMidnight(_filter.StartDate);
			var end = ToLocalMidnight(_filter.EndDate);
			var availabilityTask = HotelService.GetAvailabilityAsync(start, end);
			var bookingsTask = HotelService.GetBookingsAsync();
			await Task.WhenAll(availabilityTask, bookingsTask);

			var result = await availabilityTask;
			var bookings = await bookingsTask;

			_availability.Clear();
			_availability.AddRange(result);
			_bookings.Clear();
			_bookings.AddRange(bookings);
		}
		catch (Exception ex)
		{
			_isError = true;
			_message = ex.Message;
		}
		finally
		{
			_loading = false;
		}
	}

	private async Task BookAsync(int roomId)
	{
		_loading = true;
		_message = null;
		_isError = false;

		try
		{
			await HotelService.CreateBookingAsync(new CreateHotelBookingDto(
				roomId,
				ToLocalMidnight(_filter.StartDate),
				ToLocalMidnight(_filter.EndDate)));

			await RefreshAsync();
			_message = "Booking confirmed.";
		}
		catch (Exception ex)
		{
			_isError = true;
			_message = ex.Message;
		}
		finally
		{
			_loading = false;
		}
	}

	private async Task CancelAsync(long bookingId, MouseEventArgs args)
	{
		if (!args.ShiftKey)
		{
			var confirmed = await Js.InvokeAsync<bool>("confirm", $"Cancel hotel booking #{bookingId}?");
			if (!confirmed)
			{
				return;
			}
		}

		_loading = true;
		_message = null;
		_isError = false;

		try
		{
			await HotelService.CancelBookingAsync(bookingId);
			await RefreshAsync();
			_message = $"Booking #{bookingId} cancelled.";
		}
		catch (Exception ex)
		{
			_isError = true;
			_message = ex.Message;
		}
		finally
		{
			_loading = false;
		}
	}

	private void SetDefaultDates()
	{
		_filter.StartDate = DateOnly.FromDateTime(DateTime.Today);
		_filter.EndDate = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
	}

	private static DateTimeOffset ToLocalMidnight(DateOnly date)
	{
		var local = date.ToDateTime(TimeOnly.MinValue, DateTimeKind.Local);
		return new DateTimeOffset(local);
	}

	private sealed class HotelFilterModel
	{
		public DateOnly StartDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
		public DateOnly EndDate { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
	}

}
